{
  "_note": "Admin one-time setup: put the service's Google OAuth client under 'google' (Cloud Console -> your project -> APIs & Services -> Credentials -> your Web OAuth client). Users then just click 'Sign in with Google'; no one ever touches the Cloud Console. auth.allowlist optionally restricts which Google accounts may sign in (empty = anyone; accounts are isolated per user).",
  "google": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "client_secret": "YOUR_CLIENT_SECRET"
  },
  "auth": {
    "allowlist": [
      "you@example.com"
    ]
  },
  "dashboard": {
    "lat": 36.17,
    "lon": -115.14,
    "timezone": "America/Los_Angeles"
  },
  "dither": "floyd",
  "folder": {
    "dir": "~/Pictures/frame"
  },
  "picsum": {
    "height": 1600,
    "width": 1200
  },
  "port": 8765,
  "public_url": "https://frame.example.com",
  "build": "1",
  "quiet_end": "07:00",
  "quiet_start": "22:00",
  "rotation_minutes": 60,
  "source": "picsum",
  "url": {
    "template": "https://picsum.photos/seed/{seed}/1200/1600"
  }
}
