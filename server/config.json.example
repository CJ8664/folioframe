{
  "_note": "No OAuth anywhere in this file. The admin deploys; each user brings their own Google OAuth client via the welcome page (sign-in + Photos). auth.allowlist optionally restricts which Google accounts may sign in (empty = anyone; accounts are isolated per user).",
  "auth": {
    "allowlist": [
      "you@example.com"
    ]
  },
  "dashboard": {
    "lat": 36.17,
    "lon": -115.14,
    "timezone": "America/Los_Angeles"
  },
  "dither": "floyd",
  "folder": {
    "dir": "~/Pictures/frame"
  },
  "picsum": {
    "height": 1600,
    "width": 1200
  },
  "port": 8765,
  "public_url": "https://frame.example.com",
  "quiet_end": "07:00",
  "quiet_start": "22:00",
  "rotation_minutes": 60,
  "source": "picsum",
  "url": {
    "template": "https://picsum.photos/seed/{seed}/1200/1600"
  }
}